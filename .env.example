# Copie este archivo como .env y complete los valores. El .env nunca se sube al
# repositorio. Aquí solo van los nombres de las variables.

# Conexión de la API: rol api_hotel por el pooler de Supabase en modo sesión (puerto 5432).
# Formato: postgresql://api_hotel.<ref del proyecto>:<contraseña>@<host del pooler>:5432/postgres?sslmode=verify-full&sslrootcert=/run/certs/supabase-ca.crt
DATABASE_URL=

# Llave para firmar las sesiones (JWT). Mínimo 32 caracteres aleatorios.
JWT_SECRET=

# Mailtrap Email Sandbox: token con alcance de sandbox y número de la bandeja.
MAILTRAP_TOKEN=
MAILTRAP_INBOX_ID=

# Conexión del respaldo: rol respaldo_hotel (solo lectura), mismo formato que DATABASE_URL.
RESPALDO_DATABASE_URL=

# Almacenamiento de Supabase por su interfaz S3 (Storage, Configuration, S3).
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_BUCKET=

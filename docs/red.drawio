gn=center;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=11;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="506.6" y="673.0" width="256.7" height="64.1" as="geometry"/></mxCell><mxCell id="c40" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fdf1e4;strokeColor=#b0743a;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1390" y="80" width="420" height="190" as="geometry"/></mxCell><mxCell id="c41" value="&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#7a4a17&quot;&gt;&lt;b&gt;Mailtrap (SaaS)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=13.5;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="1533.8" y="89.0" width="132.4" height="23.8" as="geometry"/></mxCell><mxCell id="c42" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0743a;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1410" y="125" width="380" height="125" as="geometry"/></mxCell><mxCell id="c43" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#1a1a1a&quot;&gt;&lt;b&gt;Email Sandbox API&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;sandbox.api.mailtrap.io&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;TCP 443, HTTPS&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;token Bearer guardado en el .env&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;correos retenidos, sin envío real&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=13;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="1500.7" y="146.9" width="198.6" height="81.2" as="geometry"/></mxCell><mxCell id="c44" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#e9f4ec;strokeColor=#2e6b3f;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1390" y="320" width="420" height="390" as="geometry"/></mxCell><mxCell id="c45" value="&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#1f4d2c&quot;&gt;&lt;b&gt;Supabase (PaaS)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=13.5;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="1528.7" y="329.0" width="142.6" height="23.8" as="geometry"/></mxCell><mxCell id="c46" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e6b3f;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1410" y="365" width="380" height="150" as="geometry"/></mxCell><mxCell id="c47" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#1a1a1a&quot;&gt;&lt;b&gt;Pooler compartido (IPv4)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;TCP 5432, modo sesión, TLS&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;usuario con formato [rol].[proyecto]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;rol api_hotel para la API&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;rol de solo lectura para el respaldo&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;destino: PostgreSQL, esquema hotel&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=13;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="1493.2" y="392.1" width="213.6" height="95.8" as="geometry"/></mxCell><mxCell id="c48" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e6b3f;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1410" y="560" width="380" height="125" as="geometry"/></mxCell><mxCell id
bre&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=10.5;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="442.0" y="128.5" width="531.4" height="19.6" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a5a75;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="460" y="196" width="250" height="120" as="geometry"/></mxCell><mxCell id="c21" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#1a1a1a&quot;&gt;&lt;b&gt;proxy&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Nginx con ModSecurity y OWASP CRS&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;escucha 8443 (HTTPS)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;aquí termina el TLS; hacia adentro&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;el tráfico es HTTP dentro del host&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=13;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="474.8" y="215.4" width="220.3" height="81.2" as="geometry"/></mxCell><mxCell id="c22" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;startFill=0;strokeColor=#3d4450;strokeWidth=1.5;endSize=10;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="404" y="256" as="sourcePoint"/><mxPoint x="460" y="256" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a5a75;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="860" y="150" width="260" height="90" as="geometry"/></mxCell><mxCell id="c24" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#1a1a1a&qu
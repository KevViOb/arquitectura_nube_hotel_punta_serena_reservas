"33.7" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a5a75;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="366" y="500" width="490" height="72" as="geometry"/></mxCell><mxCell id="c35" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#1a1a1a&quot;&gt;&lt;b&gt;Contenedor de respaldos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;cron a las 2:00 a. m., hora de Costa Rica: pg_dump comprimido&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;con cliente PostgreSQL 17 y copia externa al almacenamiento&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=13;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="428.4" y="509.9" width="365.2" height="52.2" as="geometry"/></mxCell><mxCell id="c36" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;startFill=0;strokeColor=#7a6a55;strokeWidth=1.5;endSize=10;startSize=10;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="572" as="sourcePoint"/><mxPoint x="400" y="636" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#eef2f8;strokeColor=#4a5a75;strokeWidth=1.4;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="366" y="636" width="490" height="58" as="geometry"/></mxCell><mxCell id="c38" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#1a1a1a&quot;&gt;&lt;b&gt;Volumen de Docker&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;copia local de los respaldos: se conservan los últimos siete&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=13;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="441.5" y="646.2" width="339.0" height="37.7" as="geometry"/></mxCell><mxCell id="c39" value="" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fdf6d8;strokeColor=#b59a3a;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="366" y="714" width="490" height="50" as="geometry"/></mxCell><mxCell id="c40" value="&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5c4a10&quot;&gt;Seguridad: credenciales y claves en el archivo .env,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5c4a10&quot;&gt;fuera del código y del repositorio&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=10.5;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="467.5" y="722.1" width="286.9" height="33.7" as="geometry"/></mxCell><mxCell id="c41" value="" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#5f6670;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="366" y="780" width="490" height="50" as="geometry"/></mxCell><mxCell id="c42" value="&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#444444&quot;&gt;Disponibilidad: todos los contenedores usan la política de reinicio&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#444444&quot;&gt;unless-stopped y se levantan solos si fallan&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=10.5;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="431.9" y="788.1" width="358.2" height="33.7" as="geometry"/></mxCell><mxCell id="c43" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#e9f4ec;strokeColor=#2e6b3f;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1120" y="120" width="520" height="310" as="geometry"/></mxCell><mxCell id="c44" value="&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#1f4d2c&quot;&gt;&lt;b&gt;Nube pública gestionada&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Supabase, capa gratuita (PaaS)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=13.5;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="1278.5" y="129.0" width="203.1" height="38.3" as="geometry"/></mxCell><mxCell id="c45" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e6b3f;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1140" y="190" width="480" height="118" as="geometry"/></mxCell><mxCell id="c46" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#1a1a1a&quot;&gt;&lt;b&gt;PostgreSQL administrado&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;esquema hotel: ocho tablas y restricción contra traslapes&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;acceso solo con las credenciales de la API y del respaldo,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;nunca desde el navegador&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=13;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="1214.6" y="215.6" width="330.7" height="66.7" as="geometry"/></mxCell><mxCell id="c47" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e6b3f;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1140" y="328" width="480" height="80" as="geometry"/></mxCell><mxCell id="c48" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#1a1a1a&quot;&gt;&lt;b&gt;Almacenamiento de objetos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;bucket privado con la copia externa de los respaldos&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;spaci
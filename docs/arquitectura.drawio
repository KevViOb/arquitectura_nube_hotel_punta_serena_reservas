x="1" parent="1"><mxGeometry x="263.5" y="157.5" width="62.9" height="14.2" as="geometry"/></mxCell><mxCell id="c13" value="&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#444444&quot;&gt;HTTPS 443&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=10.5;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="259.5" y="154.5" width="70.9" height="19.6" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#eef2f8;strokeColor=#4a5a75;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="330" y="40" width="560" height="816" as="geometry"/></mxCell><mxCell id="c15" value="&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#2b3a55&quot;&gt;&lt;b&gt;Host con Docker, infraestructura propia&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;cómputo, red y almacenamiento administrados por el equipo (IaaS)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=13.5;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="416.5" y="49.0" width="387.0" height="38.3" as="geometry"/></mxCell><mxCell id="c16" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a5a75;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="520" height="150" as="geometry"/></mxCell><mxCell id="c17" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#1a1a1a&quot;&gt;&lt;b&gt;Nginx con ModSecurity: proxy inverso y WAF&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;único puerto publicado hacia la red pública: 443&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;enruta / al frontend y /api/ a la API&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;imagen owasp/modsecurity-crs con etiqueta LTS fijada&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=13;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="438.4" y="106.0" width="343.2" height="66.7" as="geometry"/></mxCell><mxCell id="c18" value="" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fdf6d8;strokeColor=#b59a3a;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="362" y="188" width="496" height="50" as="geometry"/></mxCell><mxCell id="c19" value="&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5c4a10&quot;&gt;Seguridad: TLS, WAF con OWASP CRS (paranoia 1, umbral 5), cabeceras&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5c4a10&quot;&gt;de seguridad y límite de peticiones por dirección&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=10.5;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="413.2" y="196.1" width="393.7" height="33.7" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a5a75;strokeWidth=1.2;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="350" y="276" width="520" height="332" as="geometry"/></mxCell><mxCell id="c21" value="&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2b3a55&quot;&gt;&lt;b&gt;Red interna de Docker Compose, sin exposición a la red pública&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=right;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=10.5;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="469.2" y="584.5" width="390.8" height="19.6" as="geometry"/></mxCell><mxCell id="c22" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a5a75;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="366" y="330" width="240" height="88" as="geometry"/></mxCell><mxCell id=
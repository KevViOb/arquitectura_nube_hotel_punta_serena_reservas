;startArrow=ERmandOne;startFill=0;strokeColor=#2e6b3f;strokeWidth=1.5;endSize=10;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="596" as="sourcePoint"/><mxPoint x="570" y="700" as="targetPoint"/><Array as="points"><mxPoint x="720" y="618"/><mxPoint x="545" y="618"/><mxPoint x="545" y="700"/></Array></mxGeometry></mxCell><mxCell id="c168" value="" style="html=1;rounded=0;endArrow=ERzeroToMany;endFill=0;startArrow=ERzeroToOne;startFill=0;strokeColor=#2e6b3f;strokeWidth=1.5;endSize=10;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="656" as="sourcePoint"/><mxPoint x="570" y="720" as="targetPoint"/><Array as="points"><mxPoint x="190" y="720"/></Array></mxGeometry></mxCell><mxCell id="c169" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#e9f4ec;strokeColor=#2e6b3f;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1100" y="480" width="310" height="241.5" as="geometry"/></mxCell><mxCell id="c170" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#1f4d2c&quot;&gt;&lt;b&gt;Restricciones principales&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1a1a1a&quot;&gt;reservas_sin_traslape: EXCLUDE con btree_gist,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1a1a1a&quot;&gt;misma habitación y rango [fecha_entrada,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1a1a1a&quot;&gt;fecha_salida) traslapado; no aplica a canceladas&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1a1a1a&quot;&gt;temporadas: EXCLUDE, rangos sin traslape&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1a1a1a&quot;&gt;reservas: fecha_salida &amp;gt; fecha_entrada&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1a1a1a&quot;&gt;codigo: 8 caracteres, sin O, 0, I ni 1&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1a1a1a&quot;&gt;estado: confirmada, en_curso, finalizada&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1a1a1a&quot;&gt;o cancelada; en_curso y finalizada exigen&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1a1a1a&quot;&gt;las horas reales de check in y check out&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1a1a1a&quot;&gt;correo único sin distinguir mayúsculas&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1a1a1a&quot;&gt;rol: recepcion o administracion&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1a1a1a&quot;&gt;esquema hotel; el rol api_hotel no borra&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1a1a1a&quot;&gt;datos e inserta en bitacora sin modificarla&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=12;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="1108.0" y="487.0" width="269.0" height="216.9" as="geometry"/></mxCell><mxCell id="c171" value="&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#444444&quot;&gt;PK llave primaria · FK llave foránea · UQ valor único · UQ1 único en conjunto&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=10.5;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="36.0" y="836.5" width="415.4" height="19.6" as="geometry"/></mxCell><mxCell id="c172" value="&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#444444&quot;&gt;Cada relación termina en la columna FK de la tabla hija, que referencia la llave primaria (id) de la tabla padre.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=10.5;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="36.0" y="858.5" width="594.0" height="19.6" as="geometry"/></mxCell><mxCell id="c173" value="" style="html=1;rounded=0;endArrow=ERmandOne;endFill=0;startArrow=none;startFill=0;strokeColor=#2e6b3f;strokeWidth=1.5;endSize=10;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="846" as="sourcePoint"/><mxPoint x="680" y="846" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c174" value="&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#444444&quot;&gt;exactamente uno&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=10.5;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="684.0" y="836.5" width="106.2" height="19.6" as="geometry"/></mxCell><mxCell id="c175" value="" style="html=1;rounded=0;endArrow=ERzeroToOne;endFill=0;startArrow=none;startFill=0;strokeColor=#2e6b3f;strokeWidth=1.5;endSize=10;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810.21875" y="846" as="sourcePoint"/><mxPoint x="850.21875" y="846" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c176" value="&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#444444&quot;&gt;cero o uno&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verdana;fontSize=10.5;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="854.2" y="836.5" width="69.6" height="19.6" as="geometry"/></mxCell><mxCell id="c177" value="" style="html=1;rounded=0;endArrow=ERoneToMany;endFill=0;startArrow=none;startFill=0;strokeColor=#2e6b3f;strokeWidth=1.5;endSize=10;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="943.78125" y="846" as="sourcePoint"/><mxPoint x="983.78125" y="846" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c178" value="&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#444444&quot;&gt;uno o muchos&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;spacingTop=0;fontFamily=Verd